        "profile": {
          "uri": "at://did:plc:p5t4ri3u4rr24wglznjsb5uv/com.emdashcms.experimental.package.profile/backlinksbeheer-links",
          "cid": "bafyreiesmauvp56kbqwdtz32ux5zomskwp36hntdafu3jryz6e5ht42cra",
          "value": {
            "id": "at://did:plc:p5t4ri3u4rr24wglznjsb5uv/com.emdashcms.experimental.package.profile/backlinksbeheer-links",
            "name": "Backlinksbeheer Link Check",
            "slug": "backlinksbeheer-links",
            "type": "emdash-plugin",
            "$type": "com.emdashcms.experimental.package.profile",
            "authors": [
              {
                "url": "https://backlinksbeheer.nl",
                "name": "Backlinksbeheer"
              }
            ],
            "license": "MIT",
            "keywords": [
              "seo",
              "links",
              "monitoring"
            ],
            "sections": {
              "description": "Check outbound links from saved EmDash entries with [Backlinksbeheer](https://backlinksbeheer.nl). No account or API key required.\n\nChoose a content collection and saved entry, inspect its links, then check up to two links per step. Every observation includes the HTTP status and measurement time. A one-minute pause applies before contacting the same host again.\n\n- HTTP 2xx: reachable.\n- HTTP 3xx: redirect observed; destination shown, not followed.\n- HTTP 404 or 410: missing at the time checked, not proof of permanent removal.\n- HTTP 403, 429, server errors and timeouts: unknown.\n\nReads saved Portable Text links and static HTML anchors. Ignores scripts, same-site links, email links and private IP literals. HEAD first, with one GET fallback for servers that reject HEAD. At most 200 distinct outbound links per entry; a warning appears when content exceeds the inspection limits.\n\nRequires EmDash 1.1+ and a plugin sandbox. Permissions: content:read, schema:read and unrestricted network requests. Only linked URLs go to their destination websites; entry text is not uploaded to Backlinksbeheer. Reports stay in the site's plugin storage. The private admin page requires plugin-management permission.\n\nNo link edits, redirects, background crawling or account synchronization. The latest report is shared by site administrators. This complements account-based backlink monitoring on Backlinksbeheer.\n\n[Source and full instructions](https://github.com/smrht/emdash-plugins/tree/main/packages/backlinksbeheer-links)."
            },
            "security": [
              {
                "email": "security@emdashplugins.nl"
              }
            ],
            "extensions": {
              "com.emdashcms.experimental.package.profileExtension": {
                "$type": "com.emdashcms.experimental.package.profileExtension",
                "repository": "https://github.com/smrht/emdash-plugins",
                "releasePolicy": {
                  "$type": "com.emdashcms.experimental.package.profileExtension#releasePolicy",
                  "requireProvenance": false
                }
              }
            },
            "description": "Check outbound links in saved EmDash entries with HTTP evidence, timestamps and honest unknown results.",
            "lastUpdated": "2026-11-01T07:29:04.076Z"
          }
        },
