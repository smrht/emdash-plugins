	},
	"peerDependencies": {
		"emdash": ">=1.0.1 <2"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "1.1.0",
		"@emdash-cms/plugin-cli": "0.13.2",
		"@emdash-cms/plugin-test": "0.2.7",
		"emdash": "1.1.0",
		"esbuild": "0.28.2",
		"htmlparser2": "10.0.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"zod": "3.25.76"
	}
